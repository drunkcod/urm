  "type": "module",
  "files": ["lib"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf lib",
    "compile": "tsc",
